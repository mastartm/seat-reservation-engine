# Kopyala: cp .env.example .env  (.env commit'lenmez)
# Aşağıdakiler yerel geliştirme için örnek değerlerdir, gerçek sır değildir. Gerçek ortamda mutlaka değiştir.
MSSQL_SA_PASSWORD=ChangeMe_Local_Only_123!

# JWT imzalama anahtarı, en az 32 karakter. Üretmek için: openssl rand -base64 48
JWT_KEY=local-dev-only-jwt-key-change-me-0123456789

# İlk Admin kullanıcı (etkinlik oluşturabilir). Boş bırakılırsa Admin oluşturulmaz.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe_Admin_123!
